# ============================================
# 企业级文档知识库问答系统 - 环境配置文件
# 复制此文件为 .env 并填入实际配置值：
#   Windows: copy .env.example .env
#   macOS/Linux: cp .env.example .env
# ============================================

# ============================================
# 模型配置（默认：阿里云百炼 MaaS，OpenAI 兼容接口）
# 注意：聊天模型与嵌入模型必须来自同一服务商（同一个 BASE_URL）
# ============================================
OPENAI_API_KEY="your-api-key-here"
OPENAI_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
# 推理类模型（如 qwen3 系列）会先输出思考过程，再给出正文
OPENAI_MODEL="qwen3.8-flash"
# 该服务商下必须使用其自家嵌入模型；换过 BASE_URL 后务必同步修改，
# 并重建索引（python scripts/reindex.py），因为不同嵌入模型的向量空间不兼容
OPENAI_EMBEDDING_MODEL="qwen3.7-text-embedding-flash"

# 其他可选服务商（二选一，注释掉上面的即可）：
#
# 智谱 AI（申请：https://open.bigmodel.cn/）
# OPENAI_API_KEY="your-zhipu-api-key-here"
# OPENAI_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
# OPENAI_MODEL="GLM-4.7"
# OPENAI_EMBEDDING_MODEL="embedding-2"
#
# OpenAI 官方
# OPENAI_API_KEY="sk-your-openai-api-key"
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_MODEL="gpt-4o"
# OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# ============================================
# 向量数据库配置
# ============================================
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=enterprise_docs

# ============================================
# 文档处理配置（实测：小语料 512 分块的 Recall@1 优于 256）
# ============================================
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ============================================
# 检索配置
# ============================================
TOP_K=10
RERANK_TOP_N=5
# Rerank 为可选增强，默认关闭；开启需额外安装 FlagEmbedding 并下载本地模型
ENABLE_RERANK=false
RERANK_MODEL=BAAI/bge-reranker-large
HYBRID_WEIGHT_VECTOR=0.6
HYBRID_WEIGHT_BM25=0.4

# ============================================
# 对话配置
# 注意：推理模型（qwen3/GLM 思考链等）的思考 token 也占用该额度，
# 2048 可能导致长答案被截断，建议 4096 及以上
# ============================================
TEMPERATURE=0.1
MAX_TOKENS=4096
STREAM_OUTPUT=true
MAX_HISTORY_TURNS=10

# ============================================
# 系统配置
# ============================================
LOG_LEVEL=INFO
