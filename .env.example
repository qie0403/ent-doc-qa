# ============================================
# 企业级文档知识库问答系统 - 环境配置文件
# 复制此文件为 .env 并填入实际配置值
# ============================================

# ============================================
# OpenAI 配置（必填）
# ============================================
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ============================================
# 向量数据库配置
# ============================================
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=enterprise_docs

# ============================================
# 文档处理配置
# ============================================
CHUNK_SIZE=512
CHUNK_OVERLAP=64
SEPARATORS=["\n\n", "\n", "。", "！", "？", ".", "!", "?", " ", ""]

# ============================================
# 检索配置
# ============================================
TOP_K=10
RERANK_TOP_N=5
ENABLE_RERANK=true
RERANK_MODEL=BAAI/bge-reranker-large
HYBRID_WEIGHT_VECTOR=0.6
HYBRID_WEIGHT_BM25=0.4

# ============================================
# 对话配置
# ============================================
TEMPERATURE=0.1
MAX_TOKENS=2048
STREAM_OUTPUT=true
MAX_HISTORY_TURNS=10
ENABLE_QUERY_REWRITE=true

# ============================================
# 系统配置
# ============================================
LOG_LEVEL=INFO
